rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null; }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || role() == 'ADMIN');
      allow write: if false;
    }
    match /services/{id} { allow read: if signedIn(); allow write: if false; }
    match /establishments/{id} { allow read: if signedIn(); allow write: if false; }
    match /queueEntries/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || role() == 'ADMIN' || exists(/databases/$(database)/documents/staffAssignments/$(request.auth.uid + '-' + resource.data.serviceId)));
      allow write: if false;
    }
    match /queueCounters/{id} { allow read, write: if false; }
    match /staffAssignments/{id} { allow read: if signedIn() && role() == 'ADMIN'; allow write: if false; }
  }
}
